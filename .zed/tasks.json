// Zed tasks: open the task picker with `task: spawn` (alt-shift-t).
// Each task is a single `cmake -P` call so it works the same on macOS, Linux
// and Windows (whatever shell Zed uses); see scripts/dev.cmake.
[
  {
    "label": "c3dgl: build",
    "command": "cmake",
    "args": ["-P", "scripts/dev.cmake", "build"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "allow_concurrent_runs": false,
    "reveal": "always",
    "tags": ["build"]
  },
  {
    "label": "c3dgl: build & run in emulator",
    "command": "cmake",
    "args": ["-P", "scripts/dev.cmake", "run"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "allow_concurrent_runs": false,
    "reveal": "always",
    "tags": ["run"]
  },
  {
    "label": "c3dgl: run in emulator (no build)",
    "command": "cmake",
    "args": ["-P", "scripts/dev.cmake", "launch"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "c3dgl: clean",
    "command": "cmake",
    "args": ["-E", "rm", "-rf", "build"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "never"
  }
]
